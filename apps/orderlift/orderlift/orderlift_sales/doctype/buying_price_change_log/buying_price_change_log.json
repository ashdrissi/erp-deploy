    {"fieldname": "source_loaded_rate", "fieldtype": "Currency", "label": "Loaded Reference Rate", "options": "currency", "precision": 9},
    {"fieldname": "old_source_rate", "fieldtype": "Currency", "label": "Old Source Rate", "options": "source_currency", "precision": 9},
    {"fieldname": "new_source_rate", "fieldtype": "Currency", "label": "New Source Rate", "options": "source_currency", "precision": 9},
    {"fieldname": "source_item_price", "fieldtype": "Link", "label": "Loaded Item Price", "options": "Item Price"},
