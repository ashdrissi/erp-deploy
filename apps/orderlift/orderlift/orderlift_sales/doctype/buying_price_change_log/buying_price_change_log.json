    "item_price",
    "uom",
    "source_uom",
    "currency",
    "source_currency",
    "source_exchange_rate",
    "old_rate",
    "new_rate",
    "delta_amount",
    "delta_percent",
    "change_type",
    "source_loaded_rate",
    "old_source_rate",
    "new_source_rate",
    "source_item_price",
    "purchase_order",
    "purchase_order_item",
    "approved_by",
    "approved_on",
    "approval_reason"
