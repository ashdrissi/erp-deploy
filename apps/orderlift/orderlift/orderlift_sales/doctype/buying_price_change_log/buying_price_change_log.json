  "fields": [
    {"fieldname": "company", "fieldtype": "Link", "label": "Company", "options": "Company", "reqd": 1, "in_list_view": 1},
    {"fieldname": "supplier", "fieldtype": "Link", "label": "Supplier", "options": "Supplier", "in_list_view": 1},
    {"fieldname": "item_code", "fieldtype": "Link", "label": "Item", "options": "Item", "reqd": 1, "in_list_view": 1},
    {"fieldname": "price_list", "fieldtype": "Link", "label": "Buying Price List", "options": "Price List", "in_list_view": 1},
    {"fieldname": "item_price", "fieldtype": "Link", "label": "Updated Item Price", "options": "Item Price"},
    {"fieldname": "uom", "fieldtype": "Link", "label": "UOM", "options": "UOM"},
    {"fieldname": "source_uom", "fieldtype": "Link", "label": "Source UOM", "options": "UOM"},
    {"fieldname": "currency", "fieldtype": "Link", "label": "Currency", "options": "Currency"},
    {"fieldname": "source_currency", "fieldtype": "Link", "label": "Source Currency", "options": "Currency"},
