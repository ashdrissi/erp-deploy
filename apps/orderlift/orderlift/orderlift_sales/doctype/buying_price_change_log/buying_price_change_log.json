    {"fieldname": "old_rate", "fieldtype": "Currency", "label": "Old Rate", "options": "currency", "precision": 9},
    {"fieldname": "new_rate", "fieldtype": "Currency", "label": "New Rate", "options": "currency", "precision": 9, "reqd": 1},
