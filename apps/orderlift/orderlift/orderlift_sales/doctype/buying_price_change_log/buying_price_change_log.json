  "module": "Orderlift Sales",
  "name": "Buying Price Change Log",
  "permissions": [
    {"role": "Purchase User", "read": 1},
    {"role": "Purchase Manager", "read": 1},
    {"role": "Orderlift Admin", "read": 1},
    {"role": "System Manager", "read": 1}
